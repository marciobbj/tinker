<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_pen_toolbar"
    android:elevation="8dp"
    android:padding="12dp">

    <!-- Color picker row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <FrameLayout
            android:id="@+id/colorBlack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_color_dot"
                android:backgroundTint="@color/ink_black" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/colorRed"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_color_dot"
                android:backgroundTint="@color/ink_red" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/colorBlue"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_color_dot"
                android:backgroundTint="@color/ink_blue" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/colorGreen"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_color_dot"
                android:backgroundTint="@color/ink_green" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/colorOrange"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_color_dot"
                android:backgroundTint="@color/ink_orange" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/colorPurple"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true">
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_color_dot"
                android:backgroundTint="@color/ink_purple" />
        </FrameLayout>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="?attr/colorOutlineVariant"
        android:alpha="0.3" />

    <!-- Size + Actions row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Pen sizes -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageButton
                android:id="@+id/sizeThin"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:contentDescription="@string/pen_size_thin"
                android:padding="12dp" />

            <ImageButton
                android:id="@+id/sizeMedium"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:contentDescription="@string/pen_size_medium"
                android:padding="10dp" />

            <ImageButton
                android:id="@+id/sizeThick"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:contentDescription="@string/pen_size_thick"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Separator -->
        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="?attr/colorOutlineVariant"
            android:alpha="0.3" />

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginStart="8dp">

            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_undo"
                android:contentDescription="@string/pen_undo" />

            <ImageButton
                android:id="@+id/btnEraser"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_eraser"
                android:contentDescription="@string/pen_eraser" />

            <ImageButton
                android:id="@+id/btnDone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_check"
                android:contentDescription="@string/pen_done" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
